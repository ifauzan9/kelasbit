# ============================================================
# CONTOH konfigurasi — file ini AMAN ikut ke git (tanpa rahasia).
# Salin jadi .env.local lalu isi nilai aslinya.
# ============================================================

# Database PostgreSQL di cPanel.
# Isi PASSWORD_ANDA, atau reset password user PostgreSQL di
# cPanel -> PostgreSQL Databases -> PostgreSQL Users -> Change Password.
# Nama lengkap user & database berawalan username cPanel (mis. ktimmgvh_).
DATABASE_URL=postgresql://user:PASSWORD_ANDA@127.0.0.200:5432/nama_db
DATABASE_SSL=false

# Kunci sesi. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Wajib minimal 32 karakter. Jangan diubah setelah dipakai.
SISWA_SESSION_SECRET=isi-teks-acak-minimal-32-karakter
GURU_SESSION_SECRET=isi-teks-acak-minimal-32-karakter

# Folder penyimpanan berkas tugas (relatif ke root proyek atau absolut).
# Di hosting sebaiknya absolut dan di luar public/, mis. /home/USER/berkas-tugas
UPLOAD_DIR=./berkas-tugas

# Opsional: selain "1", nilai apa pun dianggap mati.
MAINTENANCE_MODE=