# Konfigurasi npm untuk proyek ini.
# Hosting cPanel menyetel "omit=dev" secara global, sehingga devDependencies
# (tailwindcss, @tailwindcss/postcss, typescript) ikut terbuang dan build gagal
# dengan "Cannot find module '@tailwindcss/postcss'". Baris di bawah menimpa
# setelan global tersebut.
omit=
include=dev
