# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# berkas tugas siswa (disimpan di filesystem hosting)
/berkas-tugas

# testing
/coverage

# next.js
/.next/
/out/
.next-build.zip
next-build.zip

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# PENTING: semua file .env* berisi password database & kunci sesi — jangan
# pernah di-commit. Yang boleh ikut ke git hanya .env.contoh (template tanpa
# rahasia). Pola di bawah menutup .env, .env.local, .env.production,
# .env.local.backup-supabase, dan nama lain yang diawali .env.
.env
.env.*
!.env.contoh
*.env.local
*.env.*.backup*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
